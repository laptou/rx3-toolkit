# shellcheck shell=bash
#
# Load the LLVM toolchain from flake.nix. Run `direnv allow` once after
# changing this file or flake.nix.

if has nix_direnv_version; then
  # nix-direnv caches the environment, so the shell comes up instantly.
  use flake
else
  # Plain direnv has no `use flake`. Evaluate the same dev shell and cache the
  # profile the way nix-direnv would, so repeated loads stay cheap.
  _rx3_dev_env="$(nix --extra-experimental-features 'nix-command flakes' print-dev-env \
    --profile "$PWD/.direnv/flake-profile")" || return $?
  eval "$_rx3_dev_env"
  unset _rx3_dev_env
fi
